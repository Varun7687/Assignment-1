# Copy to terraform.tfvars and replace every example value before applying.
aws_region = "us-east-1"

# Use your current public IPv4 address with /32. Do not use 0.0.0.0/0.
ssh_admin_cidr = "203.0.113.10/32"

# Separate permanent administrator key. Do not reuse the team members' keys.
admin_public_key = "ssh-ed25519 REPLACE_WITH_ADMIN_PUBLIC_KEY_DATA admin@your-computer"

# Paste the complete, separate public-key lines. Never paste private-key contents.
asha_public_key = "ssh-ed25519 REPLACE_WITH_ASHA_PUBLIC_KEY_DATA asha@your-computer"
ravi_public_key = "ssh-ed25519 REPLACE_WITH_RAVI_PUBLIC_KEY_DATA ravi@your-computer"

# Defaults are t3.micro and a 2-GiB gp3 website volume; uncomment to change.
# instance_type        = "t3.micro"
# data_volume_size_gib = 2
