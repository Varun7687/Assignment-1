#!/bin/bash
# Assignment 1 - Internal Team Status Page bootstrap for Amazon Linux 2023.
# Terraform renders the public keys and EBS volume ID into this template.
set -Eeuo pipefail
exec > >(tee -a /var/log/user-data.log | logger -t assignment-1-user-data -s 2>/dev/console) 2>&1

readonly DATA_VOLUME_ID="${data_volume_id}"
readonly ASHA_KEY_B64="${asha_public_key_b64}"
readonly RAVI_KEY_B64="${ravi_public_key_b64}"
readonly GITHUB_REPOSITORY_URL="$(printf '%s' '${github_repository_url_b64}' | base64 --decode)"
readonly MOUNT_POINT="/data/www"
readonly SITE_DIR="/data/www/status"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "ERROR: bootstrap must run as root." >&2
  exit 1
fi

echo "Installing Apache, Git, disk, ACL, and SELinux utilities..."
dnf install -y httpd git parted e2fsprogs util-linux acl policycoreutils-python-utils
# Amazon Linux 2023 already provides curl via curl-minimal.
# Installing the full curl package would conflict and abort account setup.

# Create the two key-only assignment accounts and shared editing group.
getent group webteam >/dev/null || groupadd webteam
for account in asha ravi; do
  if ! id "$account" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash "$account"
  fi
  usermod -aG webteam "$account"
done

install -d -m 0700 -o asha -g asha /home/asha/.ssh
install -d -m 0700 -o ravi -g ravi /home/ravi/.ssh
printf '%s' "$ASHA_KEY_B64" | base64 --decode > /home/asha/.ssh/authorized_keys
printf '%s' "$RAVI_KEY_B64" | base64 --decode > /home/ravi/.ssh/authorized_keys
chown asha:asha /home/asha/.ssh/authorized_keys
chown ravi:ravi /home/ravi/.ssh/authorized_keys
chmod 0600 /home/asha/.ssh/authorized_keys /home/ravi/.ssh/authorized_keys
ssh-keygen -lf /home/asha/.ssh/authorized_keys >/dev/null
ssh-keygen -lf /home/ravi/.ssh/authorized_keys >/dev/null

# Put this drop-in first so password/root login is disabled before other settings.
install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/00-assignment-1-hardening.conf <<'SSHCONFIG'
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no
SSHCONFIG
sshd -t
systemctl reload sshd

# Find the exact attached Nitro device by its EBS volume serial, not by assuming
# that it will always be /dev/nvme1n1. The attachment can arrive after boot.
TARGET_SERIAL="$${DATA_VOLUME_ID//-/}"
DATA_DISK=""
for attempt in $(seq 1 120); do
  DATA_DISK="$(lsblk -dn -o PATH,SERIAL | awk -v id="$${TARGET_SERIAL}" 'tolower($2) == tolower(id) {print $1; exit}')"
  if [[ -n "$${DATA_DISK}" && -b "$${DATA_DISK}" ]]; then
    break
  fi
  DATA_DISK=""
  sleep 5
done
if [[ -z "$${DATA_DISK}" ]]; then
  echo "ERROR: EBS volume $${DATA_VOLUME_ID} was not found after waiting 10 minutes." >&2
  lsblk -f
  exit 1
fi

echo "Using attached data device: $${DATA_DISK}"
DATA_PART="$(lsblk -nrpo NAME,TYPE "$${DATA_DISK}" | awk '$2 == "part" {print $1; exit}')"
if [[ -z "$${DATA_PART}" ]]; then
  # Do not create a new partition table over a disk that already has a filesystem.
  if blkid -p -s TYPE "$${DATA_DISK}" >/dev/null 2>&1; then
    echo "ERROR: $${DATA_DISK} has a filesystem directly on the device; refusing to alter it." >&2
    exit 1
  fi
  parted --script "$${DATA_DISK}" mklabel gpt mkpart primary ext4 1MiB 100%
  partprobe "$${DATA_DISK}" || true
  udevadm settle
  for attempt in $(seq 1 30); do
    DATA_PART="$(lsblk -nrpo NAME,TYPE "$${DATA_DISK}" | awk '$2 == "part" {print $1; exit}')"
    [[ -n "$${DATA_PART}" ]] && break
    sleep 2
  done
fi
if [[ -z "$${DATA_PART}" || ! -b "$${DATA_PART}" ]]; then
  echo "ERROR: could not identify a data partition on $${DATA_DISK}." >&2
  lsblk -f
  exit 1
fi

FILESYSTEM_TYPE="$(blkid -s TYPE -o value "$${DATA_PART}" 2>/dev/null || true)"
if [[ -z "$${FILESYSTEM_TYPE}" ]]; then
  echo "Creating ext4 on the newly created data partition $${DATA_PART}..."
  mkfs.ext4 -F "$${DATA_PART}"
elif [[ "$${FILESYSTEM_TYPE}" != "ext4" ]]; then
  echo "ERROR: expected ext4 on $${DATA_PART}, found $${FILESYSTEM_TYPE}; refusing to reformat." >&2
  exit 1
fi
DATA_UUID="$(blkid -s UUID -o value "$${DATA_PART}")"
if [[ -z "$${DATA_UUID}" ]]; then
  echo "ERROR: could not read the data filesystem UUID." >&2
  exit 1
fi

mkdir -p "$${MOUNT_POINT}"
FSTAB_ENTRY="UUID=$${DATA_UUID} $${MOUNT_POINT} ext4 defaults,nofail 0 2"
if ! grep -Fq "$${FSTAB_ENTRY}" /etc/fstab; then
  printf '%s\n' "$${FSTAB_ENTRY}" >> /etc/fstab
fi
if ! mountpoint -q "$${MOUNT_POINT}"; then
  mount "$${MOUNT_POINT}"
fi
mountpoint -q "$${MOUNT_POINT}"

mkdir -p "$${SITE_DIR}"
if [[ ! -s "$${SITE_DIR}/index.html" ]]; then
  cat > "$${SITE_DIR}/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Northwind Logistics service status demo page.">
  <meta name="glean-artifact-type" content="web_design">
  <title>Service Status | Northwind Logistics</title>
  <style>
    :root {
      --artifact-background: #ffffff;
      --artifact-background-light: #f1f3f6;
      --artifact-background-mid: #e9ecf1;
      --artifact-border-light: #e3e6ec;
      --artifact-border-dark: #cdd2db;
      --artifact-primary-brand: #3559e6;
      --artifact-primary-highlight: #0d0f14;
      --artifact-primary-hover: #2442b8;
      --artifact-selected: #eaeefc;
      --artifact-text-primary: #11141a;
      --artifact-text-secondary: #5c6470;
      --artifact-text-highlight: #e8eefc;
      --artifact-positive-background: #e8f6ee;
      --artifact-positive-text: #125a3c;
      --artifact-positive: #159a6a;
      --artifact-warning-background: #fff3dc;
      --artifact-warning-text: #784b00;
      --artifact-warning: #a76600;
      --artifact-negative: #dc4c4c;
    }
    html[data-theme='dark'] {
      --artifact-background: #0a0b0e;
      --artifact-background-light: #121419;
      --artifact-background-mid: #181b22;
      --artifact-border-light: #23262e;
      --artifact-border-dark: #343844;
      --artifact-primary-brand: #6a92ff;
      --artifact-primary-highlight: #f5f7fb;
      --artifact-primary-hover: #88a8ff;
      --artifact-selected: #1a2030;
      --artifact-text-primary: #eef0f4;
      --artifact-text-secondary: #9aa0ad;
      --artifact-text-highlight: #14213d;
      --artifact-positive-background: #0e2a1d;
      --artifact-positive-text: #c8f5da;
      --artifact-positive: #46d39a;
      --artifact-warning-background: #38270e;
      --artifact-warning-text: #ffd995;
      --artifact-warning: #f2b84b;
      --artifact-negative: #ff6b6b;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) {
        --artifact-background: #0a0b0e;
        --artifact-background-light: #121419;
        --artifact-background-mid: #181b22;
        --artifact-border-light: #23262e;
        --artifact-border-dark: #343844;
        --artifact-primary-brand: #6a92ff;
        --artifact-primary-highlight: #f5f7fb;
        --artifact-primary-hover: #88a8ff;
        --artifact-selected: #1a2030;
        --artifact-text-primary: #eef0f4;
        --artifact-text-secondary: #9aa0ad;
        --artifact-text-highlight: #14213d;
        --artifact-positive-background: #0e2a1d;
        --artifact-positive-text: #c8f5da;
        --artifact-positive: #46d39a;
        --artifact-warning-background: #38270e;
        --artifact-warning-text: #ffd995;
        --artifact-warning: #f2b84b;
        --artifact-negative: #ff6b6b;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--artifact-background);
      color: var(--artifact-text-primary);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      letter-spacing: -0.005em;
    }
    .site-shell { width: min(100% - 48px, 1080px); margin: 0 auto; }
    .site-header {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--artifact-border-light);
    }
    .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--artifact-text-primary); }
    .brand-mark {
      width: 34px; height: 34px; display: grid; place-items: center;
      border-radius: 7px; background: var(--artifact-primary-brand); color: var(--artifact-background);
      font-weight: 700; font-size: 15px; letter-spacing: 0;
    }
    .brand-name { font-size: 13px; line-height: 1.2; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
    .brand-subtitle { display: block; margin-top: 4px; color: var(--artifact-text-secondary); font-size: 11px; font-weight: 500; letter-spacing: .12em; }
    .header-note, .eyebrow, .section-label {
      color: var(--artifact-text-secondary); font-family: "SF Mono", "Cascadia Code", Consolas, monospace;
      font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
    }
    .hero { padding: 76px 0 54px; }
    .eyebrow { margin: 0 0 18px; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 330px); gap: 56px; align-items: end; }
    h1, h2, h3, p { margin-top: 0; }
    h1 {
      max-width: 720px; margin-bottom: 18px; font-size: clamp(2.8rem, 7vw, 5.1rem);
      font-weight: 300; line-height: 1.02; letter-spacing: -.055em;
    }
    .hero-copy { max-width: 620px; margin-bottom: 0; color: var(--artifact-text-secondary); font-size: 18px; }
    .overall-status {
      padding: 22px 24px 20px; border: 1px solid var(--artifact-border-light);
      border-radius: 8px; background: var(--artifact-text-highlight);
    }
    .overall-status .section-label { margin: 0 0 13px; }
    .status-main { display: flex; align-items: center; gap: 11px; margin-bottom: 6px; font-size: 22px; font-weight: 600; letter-spacing: -.025em; }
    .status-main .status-dot { width: 10px; height: 10px; flex: 0 0 10px; border-radius: 50%; background: var(--artifact-warning); }
    .status-caption { margin: 0; color: var(--artifact-text-secondary); font-size: 13px; line-height: 1.5; }
    .components { padding: 28px 0 0; border-top: 1px solid var(--artifact-border-light); }
    .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 15px; }
    h2 { margin-bottom: 0; font-size: 20px; font-weight: 550; letter-spacing: -.025em; }
    .section-heading p { margin: 0; color: var(--artifact-text-secondary); font-size: 13px; }
    .service-list { border-top: 1px solid var(--artifact-border-dark); }
    .service-row {
      display: grid; grid-template-columns: minmax(170px, .9fr) minmax(220px, 1.5fr) minmax(140px, .65fr);
      gap: 24px; align-items: center; padding: 20px 4px; border-bottom: 1px solid var(--artifact-border-light);
    }
    .service-name { margin: 0; font-size: 16px; font-weight: 600; }
    .service-description { margin: 0; color: var(--artifact-text-secondary); font-size: 14px; }
    .service-state { justify-self: end; display: inline-flex; align-items: center; gap: 8px; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .service-state::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .service-state.operational { color: var(--artifact-positive-text); background: var(--artifact-positive-background); }
    .service-state.degraded { color: var(--artifact-warning-text); background: var(--artifact-warning-background); }
    .note {
      display: grid; grid-template-columns: 170px 1fr; gap: 24px; margin-top: 42px; padding: 21px 0;
      border-top: 1px solid var(--artifact-border-light); border-bottom: 1px solid var(--artifact-border-light);
    }
    .note .section-label { margin: 3px 0 0; }
    .note p { max-width: 720px; margin: 0; color: var(--artifact-text-secondary); font-size: 14px; }
    .site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 26px 0 42px; color: var(--artifact-text-secondary); font-size: 12px; }
    .site-footer p { margin: 0; }
    .site-footer strong { color: var(--artifact-text-primary); font-weight: 550; }
    @media (max-width: 720px) {
      .site-shell { width: min(100% - 36px, 1080px); }
      .header-note { max-width: 145px; text-align: right; line-height: 1.5; }
      .hero { padding: 54px 0 38px; }
      .hero-grid { grid-template-columns: 1fr; gap: 28px; }
      .overall-status { max-width: 420px; }
      .service-row { grid-template-columns: minmax(0, 1fr) auto; gap: 7px 14px; }
      .service-description { grid-column: 1; grid-row: 2; }
      .service-state { grid-column: 2; grid-row: 1 / span 2; }
      .note { grid-template-columns: 1fr; gap: 8px; margin-top: 32px; }
      .site-footer { flex-direction: column; gap: 8px; }
    }
    @media (max-width: 420px) {
      .site-shell { width: min(100% - 28px, 1080px); }
      .brand-name { font-size: 11px; }
      .brand-subtitle { font-size: 10px; }
      .header-note { font-size: 9px; }
      .section-heading { display: block; }
      .section-heading p { margin-top: 6px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
    @media print {
      @page { size: auto !important; }
      body { margin: 0; padding: 0.4in 0.6in; background: #fff; color: #11141a; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .site-shell { width: 100%; max-width: 100%; }
      .site-header { min-height: 54px; }
      .hero { padding: 38px 0 30px; }
      .hero-grid { grid-template-columns: 1fr 280px; gap: 28px; }
      .service-row, .overall-status, .note { break-inside: avoid; }
      .site-footer { padding-bottom: 0; }
    }
  </style>
</head>
<body>
  <div class="site-shell">
    <header class="site-header" data-glean-id="site-header">
      <a class="brand" href="#top" aria-label="Northwind Logistics status home">
        <span class="brand-mark" aria-hidden="true">N</span>
        <span class="brand-name">Northwind<span class="brand-subtitle">Logistics</span></span>
      </a>
      <span class="header-note">Service status · demo</span>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="page-title" data-glean-id="status-overview">
        <p class="eyebrow">Operations / Service health</p>
        <div class="hero-grid">
          <div>
            <h1 id="page-title" data-glean-id="page-title">Service status</h1>
            <p class="hero-copy">A simple overview of the systems supporting Northwind Logistics.</p>
          </div>
          <aside class="overall-status" aria-label="Overall sample status: degraded" data-glean-id="overall-status">
            <p class="section-label">Overall status · sample</p>
            <div class="status-main"><span class="status-dot" aria-hidden="true"></span><span>Degraded</span></div>
            <p class="status-caption">One component is marked as degraded in this demo snapshot.</p>
          </aside>
        </div>
      </section>

      <section class="components" aria-labelledby="components-title" data-glean-id="component-statuses">
        <div class="section-heading">
          <h2 id="components-title">Component status</h2>
          <p>Example values for the assignment</p>
        </div>
        <div class="service-list" role="list">
          <article class="service-row" role="listitem" data-glean-id="service-website">
            <h3 class="service-name">Website</h3>
            <p class="service-description">Customer-facing web experience</p>
            <span class="service-state operational">Operational</span>
          </article>
          <article class="service-row" role="listitem" data-glean-id="service-database">
            <h3 class="service-name">Database</h3>
            <p class="service-description">Core data service</p>
            <span class="service-state operational">Operational</span>
          </article>
          <article class="service-row" role="listitem" data-glean-id="service-api">
            <h3 class="service-name">API</h3>
            <p class="service-description">Application and partner integrations</p>
            <span class="service-state degraded">Degraded</span>
          </article>
        </div>
      </section>

      <aside class="note" aria-label="Demo data notice" data-glean-id="demo-notice">
        <p class="section-label">About this page</p>
        <p>This is a static assignment demo. The statuses above are sample values; this page is not connected to live health checks or incident monitoring.</p>
      </aside>
    </main>

    <footer class="site-footer" data-glean-id="site-footer">
      <p><strong>Northwind Logistics</strong> · Assignment 1</p>
      <p>Static status page demonstration</p>
    </footer>
  </div>
  <script>
    if (window.GleanBridge) {
      window.GleanBridge.postMessage({
        actionId: 'export-pdf',
        type: 'glean-add-menu',
        metadata: { label: 'Export as PDF', icon: 'export' }
      });
      window.GleanBridge.onMessage('action', function(data) {
        if (data.actionId === 'export-pdf') window.print();
      });
    }

    function prepareChartsForPrint() {
      document.querySelectorAll('[_echarts_instance_]').forEach(function(el) {
        if (!window.echarts) return;
        var chart = window.echarts.getInstanceByDom(el);
        if (!chart) return;
        var img = new Image();
        img.src = chart.getDataURL({ type: 'png', pixelRatio: 2 });
        img.className = 'print-chart-img';
        img.style.cssText = 'width:100%;height:100%;object-fit:contain;position:absolute;top:0;left:0;z-index:10;';
        el.dataset.prevPosition = el.style.position;
        el.style.position = 'relative';
        el.appendChild(img);
      });
    }

    function cleanUpAfterPrint() {
      document.querySelectorAll('[_echarts_instance_]').forEach(function(el) {
        var img = el.querySelector('.print-chart-img');
        if (!img) return;
        img.remove();
        el.style.position = el.dataset.prevPosition || '';
        delete el.dataset.prevPosition;
      });
    }

    window.addEventListener('beforeprint', prepareChartsForPrint);
    window.addEventListener('afterprint', cleanUpAfterPrint);
  </script>
</body>
</html>
HTML
fi

# Add persistent SELinux labeling so Apache is allowed to read from EBS.
semanage fcontext -a -t httpd_sys_content_t '/data/www(/.*)?' 2>/dev/null \
  || semanage fcontext -m -t httpd_sys_content_t '/data/www(/.*)?'
restorecon -RF "$${MOUNT_POINT}"

# Make files collaboratively editable and keep future shell-created files group-writable.
chown -R root:webteam "$${SITE_DIR}"
find "$${SITE_DIR}" -type d -exec chmod 2775 {} +
find "$${SITE_DIR}" -type f -exec chmod 0664 {} +
cat > /etc/profile.d/assignment-1-webteam-umask.sh <<'UMASK'
if id -nG "$(id -un)" 2>/dev/null | tr ' ' '\n' | grep -qx webteam; then
  umask 0002
fi
UMASK
chmod 0644 /etc/profile.d/assignment-1-webteam-umask.sh

# Capture real first-boot validation output without overwriting a prior report.
if [[ ! -e "$${SITE_DIR}/README.md" ]]; then
  install -o root -g webteam -m 0664 /dev/null "$${SITE_DIR}/README.md"
  {
    printf '%s\n' '# Assignment 1 — EC2 deployment report' ''
    printf '%s\n' 'Generated on first boot. These are command outputs from this instance.' ''
    printf '%s\n' '## Files modified in the last day' '' '```text'
    find "$${MOUNT_POINT}" -type f -mtime -1 -print
    printf '%s\n' '```' '' '## Files owned by the webteam group' '' '```text'
    find "$${MOUNT_POINT}" -type f -group webteam -print
    printf '%s\n' '```'
  } > "$${SITE_DIR}/README.md"
fi

# Serve the EBS-backed folder at /status/.
cat > /etc/httpd/conf.d/assignment-1-status-page.conf <<'APACHE'
Alias "/status/" "/data/www/status/"
<Directory "/data/www/status">
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>
<Directory "/data/www/status/.git">
    Require all denied
</Directory>
APACHE
httpd -t

# Keep one trusted shared working tree; do not reset branches or existing work.
# This design is for mutually trusted team members, not production isolation.
if [[ -L "$SITE_DIR" || -L "$SITE_DIR/.git" ]]; then
  echo "ERROR: refusing a symlinked site or Git metadata directory." >&2
  exit 1
fi
if [[ -e "$SITE_DIR/.git" && ! -d "$SITE_DIR/.git" ]]; then
  echo "ERROR: linked Git worktrees are not supported by this shared setup." >&2
  exit 1
fi
GITHUB_URL_PATTERN='^(https://github\.com/|git@github\.com:)[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+\.git$'
if [[ -n "$GITHUB_REPOSITORY_URL" && ! "$GITHUB_REPOSITORY_URL" =~ $GITHUB_URL_PATTERN ]]; then
  echo "ERROR: use https://github.com/OWNER/REPO.git or git@github.com:OWNER/REPO.git, without credentials." >&2
  exit 1
fi

# Trust only this exact path, separately for root, Asha, and Ravi.
for account in root asha ravi; do
  if ! runuser -u "$account" -- git config --global --fixed-value --get-all safe.directory "$SITE_DIR" >/dev/null; then
    runuser -u "$account" -- git config --global --add safe.directory "$SITE_DIR"
  fi
done

NEW_REPOSITORY=0
if [[ ! -d "$SITE_DIR/.git" ]]; then
  git -C "$SITE_DIR" init --shared=group --initial-branch=assignment-1
  NEW_REPOSITORY=1
fi

# Refuse an unexpected existing remote rather than silently changing it.
if [[ -n "$GITHUB_REPOSITORY_URL" ]]; then
  if git -C "$SITE_DIR" remote | grep -Fxq origin; then
    EXISTING_REMOTE="$(git -C "$SITE_DIR" remote get-url origin)"
    if [[ "$EXISTING_REMOTE" != "$GITHUB_REPOSITORY_URL" ]]; then
      echo "ERROR: origin already points elsewhere. Review git remote -v; it was not changed." >&2
      exit 1
    fi
    # Also reject a separate push destination; never publish to a surprise URL.
    while IFS= read -r push_url; do
      if [[ "$push_url" != "$GITHUB_REPOSITORY_URL" ]]; then
        echo "ERROR: origin has a different push destination. Review it manually." >&2
        exit 1
      fi
    done < <(git -C "$SITE_DIR" remote get-url --push --all origin)
  else
    git -C "$SITE_DIR" remote add origin "$GITHUB_REPOSITORY_URL"
  fi
fi

git -C "$SITE_DIR" config core.sharedRepository group
# Only a genuinely new repository receives the bootstrap commit.
# An existing repository's branch, staging area and uncommitted work stay intact.
if [[ "$NEW_REPOSITORY" -eq 1 ]]; then
  git -C "$SITE_DIR" add -- index.html
  if [[ -f "$SITE_DIR/README.md" ]]; then
    git -C "$SITE_DIR" add -- README.md
  fi
  git -C "$SITE_DIR" -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -c user.name="Assignment 1 Bootstrap" -c user.email="assignment-1@localhost.invalid" \
    commit -m "Bootstrap Assignment 1 status page"
fi

# Shared file access, including files created by future editor/Git operations.
chgrp -R webteam "$SITE_DIR"
chmod -R g+rwX "$SITE_DIR"
find "$SITE_DIR" -type d -exec chmod g+s {} +
setfacl -R -m g:webteam:rwX "$SITE_DIR"
find "$SITE_DIR" -type d -exec setfacl -m d:u::rwx,d:g::rwx,d:g:webteam:rwx,d:m::rwx,d:o::r-x {} +

# Git metadata is shared by webteam but inaccessible to other ordinary users.
chmod -R g+rwX,o-rwx "$SITE_DIR/.git"
setfacl -R -m g:webteam:rwX,o::--- "$SITE_DIR/.git"
find "$SITE_DIR/.git" -type d -exec chmod g+s {} +
find "$SITE_DIR/.git" -type d -exec setfacl -m d:u::rwx,d:g::rwx,d:g:webteam:rwx,d:m::rwx,d:o::--- {} +

if [[ -n "$GITHUB_REPOSITORY_URL" ]]; then
  echo "GitHub origin configured. No fetch, pull, commit of existing work, or push was performed."
else
  echo "GitHub URL is not set; shared access is configured and any existing origin is retained."
fi

systemctl enable --now httpd
systemctl restart httpd
for attempt in $(seq 1 30); do
  if curl -fsS http://localhost/status/ >/dev/null; then
    break
  fi
  sleep 2
done
curl -fsS http://localhost/status/ >/dev/null

printf '\nSetup completed successfully.\n'
printf 'Website: http://localhost/status/\n'
printf 'EBS mount: %s\n' "$${MOUNT_POINT}"
printf 'Data device: %s\n' "$${DATA_DISK}"
printf 'Team users: asha, ravi (webteam)\n'
